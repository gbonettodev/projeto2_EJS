<%- include('partials/head', { titulo: 'Produtos' }) %>
<div class="app-shell"><%- include('partials/sidebar', { usuario, ativo: 'produtos' }) %><main class="main-content">
  <header class="topbar"><div class="breadcrumb">ESPAÇO DE TRABALHO <span>/</span> <strong>Produtos</strong></div><div class="topbar-right"><span class="status-dot"></span> Sistema conectado</div></header>
  <section class="page-content"><div class="page-heading"><div><div class="eyebrow eyebrow-dark">CATÁLOGO RELACIONAL</div><h1>Seus produtos</h1><p>Produtos e grupos conectados em um só lugar.</p></div><a class="button button-primary" href="/produtos/novo"><span class="plus">+</span> Novo produto</a></div>
    <%- include('partials/flash', { erro }) %>
    <section class="stats-grid"><article class="stat-card"><div class="stat-icon stat-icon-mint"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.8 7.5 4.4 7.5-4.4M12 12.2V21"/></svg></div><div><span class="stat-label">PRODUTOS LISTADOS</span><strong><%= produtos.length %></strong><small><%= produtos.length === 1 ? 'produto' : 'produtos' %> nesta visualização</small></div></article><article class="stat-card"><div class="stat-icon stat-icon-lilac"><svg viewBox="0 0 24 24"><path d="M4 7.5h6l2 2h8v9H4z"/><path d="M4 7.5v-1A1.5 1.5 0 0 1 5.5 5H10l2 2"/></svg></div><div><span class="stat-label">RELACIONAMENTO</span><strong class="stat-message">Grupos e produtos</strong><small>Relação de um grupo para vários produtos.</small></div></article></section>
    <section class="panel product-panel"><div class="panel-heading"><div><h2>Lista de produtos</h2><p>A categoria vem da tabela relacionada por chave estrangeira.</p></div><form action="/produtos" method="GET" class="search-form"><div class="search-input"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><input type="search" name="busca" value="<%= busca %>" placeholder="Buscar produto ou grupo..." aria-label="Buscar produto ou grupo"></div><button class="button button-search" type="submit">Buscar</button><% if (busca) { %><a class="clear-search" href="/produtos">Limpar</a><% } %></form></div>
      <div class="table-wrap"><table><thead><tr><th>PRODUTO</th><th>GRUPO / CATEGORIA</th><th>PESO</th><th>PREÇO</th><th class="actions-heading">AÇÕES</th></tr></thead><tbody>
        <% if (produtos.length === 0) { %><tr><td colspan="5"><div class="empty-state"><div class="empty-icon"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M8.5 12h7"/></svg></div><strong><%= busca ? 'Nenhum resultado encontrado' : 'Nenhum produto cadastrado' %></strong><p><%= busca ? 'Tente outro termo ou limpe a busca.' : 'Cadastre o primeiro produto para começar.' %></p><% if (!busca) { %><a class="text-link" href="/produtos/novo">Cadastrar produto <span>→</span></a><% } %></div></td></tr>
        <% } else { produtos.forEach((produto) => { %><tr><td><div class="product-cell"><span class="product-avatar"><%= produto.nome_produto.slice(0, 1).toUpperCase() %></span><div><strong><%= produto.nome_produto %></strong><small>Código #<%= String(produto.id).padStart(4, '0') %></small></div></div></td><td><% if (produto.descricao_grupo) { %><span class="group-badge"><%= produto.descricao_grupo %></span><% } else { %><span class="no-group">Sem grupo</span><% } %></td><td><span class="table-value"><%= Number(produto.peso).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> <span>kg</span></span></td><td><span class="price-value">R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span></td><td><div class="row-actions"><a class="icon-button edit-action" href="/produtos/editar/<%= produto.id %>" aria-label="Editar <%= produto.nome_produto %>" title="Editar"><svg viewBox="0 0 24 24"><path d="m14 6 4 4M4 20l4.5-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.5 16 4 20Z"/></svg></a><a class="icon-button delete-action" href="/produtos/deletar/<%= produto.id %>" aria-label="Excluir <%= produto.nome_produto %>" title="Excluir" onclick="return confirm('Deseja excluir este produto?')"><svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6.5 7l.8 13h9.4l.8-13M9 7V4h6v3"/></svg></a></div></td></tr><% }); } %>
      </tbody></table></div><div class="table-footer"><span>Exibindo <strong><%= produtos.length %></strong> <%= produtos.length === 1 ? 'produto' : 'produtos' %><%= busca ? ` para “${busca}”` : '' %></span><span class="footer-mark"><i></i> Busca inclui nome e grupo</span></div>
    </section><footer class="page-footer">BONETTOCENTER</footer>
  </section>
</main></div></body></html>
