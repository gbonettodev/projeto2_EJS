<%- include('partials/head', { titulo: 'Novo produto' }) %>
<div class="app-shell"><%- include('partials/sidebar', { usuario, ativo: 'produtos' }) %><main class="main-content"><header class="topbar"><div class="breadcrumb"><a href="/produtos">PRODUTOS</a> <span>/</span> <strong>Novo produto</strong></div><div class="topbar-right"><span class="status-dot"></span> Sistema conectado</div></header>
  <section class="page-content form-page"><div class="page-heading"><div><div class="eyebrow eyebrow-dark">CATÁLOGO</div><h1>Adicionar produto</h1><p>Escolha o grupo e preencha os dados do item.</p></div></div><section class="panel editor-panel"><div class="editor-title"><div class="editor-icon"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M12 12v9m-7.5-13.2 7.5 4.4 7.5-4.4"/></svg></div><div><h2>Informações do produto</h2><p>O grupo selecionado será salvo como chave estrangeira.</p></div></div>
    <%- include('partials/flash', { erro }) %>
    <form action="/produtos/novo" method="POST" class="form-stack editor-form"><div class="field-group"><label for="nome_produto">Nome do produto <span class="required-star">*</span></label><input class="text-input" id="nome_produto" name="nome_produto" maxlength="100" value="<%= produto.nome_produto %>" placeholder="Ex.: Monitor UltraWide" required><small class="field-help">Use um nome fácil de reconhecer.</small></div>
      <div class="field-group"><label for="grupo_id">Grupo / categoria</label><div class="select-wrap"><select class="text-input" id="grupo_id" name="grupo_id"><option value="">Sem grupo</option><% grupos.forEach((grupo) => { %><option value="<%= grupo.id %>" <%= String(produto.grupo_id) === String(grupo.id) ? 'selected' : '' %>><%= grupo.descricao_grupo %></option><% }); %></select><span>⌄</span></div><small class="field-help">Os grupos vêm da tabela relacionada. Você pode deixar sem grupo.</small></div>
      <div class="field-row"><div class="field-group"><label for="peso">Peso <span class="required-star">*</span></label><div class="unit-input"><input id="peso" name="peso" type="number" min="0" step="0.01" value="<%= produto.peso %>" placeholder="0,00" required><span>kg</span></div></div><div class="field-group"><label for="preco">Preço <span class="required-star">*</span></label><div class="unit-input currency-input"><span>R$</span><input id="preco" name="preco" type="number" min="0" step="0.01" value="<%= produto.preco %>" placeholder="0,00" required></div></div></div>
      <div class="form-actions"><a class="button button-quiet" href="/produtos">Cancelar</a><button class="button button-primary" type="submit">Salvar produto <span>→</span></button></div></form>
  </section><footer class="page-footer">BONETTOCENTER</footer></section></main></div></body></html>
