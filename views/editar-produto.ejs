<%- include('partials/head', { titulo: 'Editar produto' }) %>
<div class="app-shell"><%- include('partials/sidebar', { usuario, ativo: 'produtos' }) %><main class="main-content"><header class="topbar"><div class="breadcrumb"><a href="/produtos">PRODUTOS</a> <span>/</span> <strong>Editar produto</strong></div><div class="topbar-right"><span class="status-dot"></span> Sistema conectado</div></header>
  <section class="page-content form-page"><div class="page-heading"><div><div class="eyebrow eyebrow-dark">CATÁLOGO · CÓDIGO #<%= String(produto.id).padStart(4, '0') %></div><h1>Editar produto</h1><p>Atualize os dados e o grupo deste item.</p></div></div><section class="panel editor-panel"><div class="editor-title"><div class="editor-icon editor-icon-edit"><svg viewBox="0 0 24 24"><path d="m14 6 4 4M4 20l4.5-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.5 16 4 20Z"/></svg></div><div><h2>Informações do produto</h2><p>A alteração de grupo atualiza a chave estrangeira.</p></div></div>
    <%- include('partials/flash', { erro }) %>
    <form action="/produtos/editar/<%= produto.id %>" method="POST" class="form-stack editor-form"><div class="field-group"><label for="nome_produto">Nome do produto <span class="required-star">*</span></label><input class="text-input" id="nome_produto" name="nome_produto" maxlength="100" value="<%= produto.nome_produto %>" required></div>
      <div class="field-group"><label for="grupo_id">Grupo / categoria</label><div class="select-wrap"><select class="text-input" id="grupo_id" name="grupo_id"><option value="" <%= produto.grupo_id == null ? 'selected' : '' %>>Sem grupo</option><% grupos.forEach((grupo) => { %><option value="<%= grupo.id %>" <%= String(produto.grupo_id) === String(grupo.id) ? 'selected' : '' %>><%= grupo.descricao_grupo %></option><% }); %></select><span>⌄</span></div><small class="field-help">O grupo atual já aparece selecionado.</small></div>
      <div class="field-row"><div class="field-group"><label for="peso">Peso <span class="required-star">*</span></label><div class="unit-input"><input id="peso" name="peso" type="number" min="0" step="0.01" value="<%= produto.peso %>" required><span>kg</span></div></div><div class="field-group"><label for="preco">Preço <span class="required-star">*</span></label><div class="unit-input currency-input"><span>R$</span><input id="preco" name="preco" type="number" min="0" step="0.01" value="<%= produto.preco %>" required></div></div></div>
      <div class="form-actions"><a class="button button-quiet" href="/produtos">Cancelar</a><button class="button button-primary" type="submit">Salvar alterações <span>→</span></button></div></form>
  </section><footer class="page-footer">BONETTOCENTER</footer></section></main></div></body></html>
